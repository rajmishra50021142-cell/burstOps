# =====================================================================
# BurstOps Interactive Demo Website — Environment Configuration Example
# =====================================================================
# This file defines the configuration options for the BurstOps single-service
# web application. All variables have safe defaults for the live Azure setup.

# Operating Mode: "cloud" (triggers live Azure experiment) or "mock" (offline test mode)
DEMO_MODE=cloud

# Public Ingress Endpoints on Azure (Provided by the deployed Azure Standard Load Balancer)
GATEWAY_BASE_URL=http://burstops-cloud-ga3cvf.centralindia.cloudapp.azure.com
LOCUST_INGRESS_URL=http://burstops-cloud-ga3cvf.centralindia.cloudapp.azure.com/locust
GRAFANA_URL=http://burstops-cloud-ga3cvf.centralindia.cloudapp.azure.com/grafana/
PROMETHEUS_URL=http://burstops-cloud-ga3cvf.centralindia.cloudapp.azure.com/metrics

# Azure Subscription & Infrastructure Identifiers (Used for Azure Portal deep links)
AZURE_SUBSCRIPTION_ID=980e5d74-260c-49bc-ba07-2343e710859d
AZURE_RESOURCE_GROUP=rg-burstops-prod
AZURE_AKS_CLUSTER=aks-burstops-ga3cvf
AZURE_FUNCTION_APP=func-burstops-cloud-ga3cvf
AZURE_APP_INSIGHTS=log-burstops-ga3cvf

# Operational Safeguards and Limits
MAX_RUN_DURATION_SECONDS=120
RECOVERY_TIMEOUT_SECONDS=60
COOLDOWN_SECONDS=5
CONCURRENT_HTTP_WORKERS=8
POLL_INTERVAL_SECONDS=2.0
RECOVERY_POLL_INTERVAL_SECONDS=2.0
