apiVersion: v1
kind: Secret
metadata:
  name: burstops-gateway-secrets
  namespace: burstops-system
  labels:
    app: burstops-gateway
type: Opaque
stringData:
  GATEWAY_HMAC_SECRET: "your-gateway-hmac-secret-here"
  FUNCTION_KEY: "your-azure-function-key-here"
  APPLICATIONINSIGHTS_CONNECTION_STRING: "InstrumentationKey=your-key;IngestionEndpoint=https://your-region.applicationinsights.azure.com/"
